# Generate infra/edge/.env with scripts/setup-edge.sh.
# Do not commit the generated file or paste its values into chat.
ADMIN_USERNAME=instructor
ADMIN_PASSWORD=
JWT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Must match the participant workflow's ARENA_URL exactly, without a trailing slash.
ACTIONS_OIDC_AUDIENCE=https://arena.costacorp.net
# Pin tested multi-architecture image tags/digests before the event.
FLOCI_IMAGE=floci/floci:latest
# --token-file requires cloudflared >= 2025.4.0.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Shared, bounded evaluation queue. Defaults target a 50-participant event.
EVALUATION_QUEUE_LIMIT=50
# Start with two VMs; allowed range 1..4. Recreate both worker and runner on change.
EVALUATION_CONCURRENCY=2
EVALUATION_QUEUE_WAIT_SECONDS=1800
